<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Capacitor -->
    <key>CAPACITOR_DEBUG</key>
    <string>$(CAPACITOR_DEBUG)</string>

    <!-- Application -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>GroupinG</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>cm.kapexpert.grouping</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Version -->
    <key>CFBundleShortVersionString</key>
    <string>2.4.2</string>

    <!-- Build -->
    <key>CFBundleVersion</key>
    <string>15</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Launch Screen -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- Device capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>

    <!-- iPhone orientation -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- iPad orientation -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- ================================ -->
    <!-- PRIVACY PERMISSIONS -->
    <!-- ================================ -->

    <!-- Camera -->
    <key>NSCameraUsageDescription</key>
    <string>GroupinG utilise votre caméra pour vous permettre de prendre des photos et d'utiliser les fonctionnalités nécessitant l'accès à la caméra.</string>

    <!-- Location - precise / approximate -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>GroupinG utilise votre position pour vous proposer des contenus et services à proximité.</string>

    <!-- Location - always (à conserver uniquement si l'application demande réellement l'accès en arrière-plan) -->
    <!--
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>GroupinG utilise votre position pour vous proposer des contenus et services à proximité.</string>
    -->

    <!-- ================================ -->
    <!-- OAUTH CALLBACK -->
    <!-- ================================ -->

    <key>CFBundleURLTypes</key>
    <array>
        <dict>

            <key>CFBundleURLName</key>
            <string>OAuth Callback</string>

            <key>CFBundleURLSchemes</key>
            <array>
                <string>cm.kapexpert.grouping</string>
            </array>

        </dict>
    </array>

</dict>
</plist>