<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
    <string>$(CAPACITOR_DEBUG)</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>CFBundleDisplayName</key>
    <string>GroupinG</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>cm.kapexpert.grouping</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Interface & Storyboards -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- Custom Deep Link / OAuth URL Schemes -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>OAuth Callback</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>cm.kapexpert.grouping</string>
            </array>
        </dict>
    </array>

    <!-- Autoriser le partage et l'ouverture d'apps externes -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>whatsapp</string>
        <string>https</string>
        <string>http</string>
        <string>tel</string>
        <string>mailto</string>
    </array>

    <!-- Description des permissions iOS (Textes explicatifs obligatoires) -->
    <key>NSCameraUsageDescription</key>
    <string>L'application nécessite l'accès à l'appareil photo pour la capture de photos et le scan de QR codes.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>L'application nécessite l'accès à votre galerie pour sélectionner des photos.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>L'application nécessite l'autorisation d'enregistrer des images dans votre galerie.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>L'application nécessite votre position pour afficher les boutiques et offres à proximité.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>L'application nécessite l'accès au microphone pour les fonctionnalités vocales ou vidéo.</string>
</dict>
</plist>